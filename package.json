{
  "name": "auth-henriz-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-totp": "tsx scripts/reset-totp.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@simplewebauthn/server": "14.0.3",
    "next": "16.3.6",
    "otplib": "13.5.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "webauthn-polyfills": "0.1.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@prisma/client": "7.10.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.17.0"
}
